<Window x:Class="FolderNotifier.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal" Title="폴더 알림 팝업"
    Width="380" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
    ShowInTaskbar="False" ShowActivated="False" Topmost="True"
    WindowStartupLocation="Manual" Background="#FFFFFF"
    FontFamily="Segoe UI Variable, Malgun Gothic" FontSize="14"
    UseLayoutRounding="True" KeyDown="NotificationKeyDown"
    MouseEnter="PauseDismissal" MouseLeave="ResumeDismissal">
    <Border Background="#FFFFFF" BorderBrush="#BCD0F5" BorderThickness="1" Padding="18,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="폴더 알림" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="DismissButton" Content="✕" Click="DismissClicked"
                    HorizontalAlignment="Right" Padding="6,2" MinWidth="28"
                    AutomationProperties.Name="알림 닫기" ToolTip="알림 닫기"/>
            </Grid>
            <TextBlock x:Name="NotificationTitle" Grid.Row="1" Margin="0,10,0,0"
                FontSize="17" FontWeight="SemiBold" Foreground="#17233B" TextWrapping="Wrap"/>
            <TextBlock x:Name="NotificationMessage" Grid.Row="2" Margin="0,8,0,0"
                Foreground="#475467" TextWrapping="Wrap" MaxHeight="160" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="OpenAppButton" Grid.Row="3" Content="앱에서 확인" Click="OpenClicked"
                HorizontalAlignment="Right" Margin="0,14,0,0" Padding="12,6"/>
        </Grid>
    </Border>
</Window>
