<Window x:Class="FolderNotifier.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal" Title="폴더 알림" Width="1100" Height="800" MinWidth="900" MinHeight="600"
    WindowStartupLocation="CenterScreen" Background="#F6F8FB" FontFamily="Segoe UI Variable, Malgun Gothic"
    FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <ScrollViewer x:Name="RootScroller" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}"
        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False">
    <Grid x:Name="MainSurface" Background="#F6F8FB" MinWidth="840" MinHeight="760" Width="{Binding ActualWidth, ElementName=RootScroller}" Height="{Binding ActualHeight, ElementName=RootScroller}">
    <Grid Margin="32,28,32,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="BrandIcon" Width="52" Height="52" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel><TextBlock Text="폴더 알림" FontSize="29" FontWeight="SemiBold"/>
                        <TextBlock Text="새 파일이 도착하면, 바로 알려드려요." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="68,12,0,0">
                    <TextBlock Text="이번 실행" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FileCount" Text="0" FontSize="18" FontWeight="SemiBold" Margin="10,0,3,0"/>
                    <TextBlock Text="개 발견" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <Border x:Name="NotificationCard" Grid.Column="2" Background="White" BorderBrush="#DFE7F2" BorderThickness="1" CornerRadius="12" Padding="16" AutomationProperties.Name="미확인 알림 카드">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image x:Name="InboxGraphic" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="알림 상태 종 그래픽"/>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <TextBlock Text="미확인 알림" FontSize="12" Foreground="{StaticResource Muted}"/>
                            <Border x:Name="UnreadCountBadge" Visibility="Collapsed" Background="#E84E5D" CornerRadius="10" Padding="7,2" HorizontalAlignment="Right">
                                <TextBlock x:Name="UnreadCountText" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="InboxStatus" Text="새 알림을 기다리고 있어요" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock x:Name="InboxSummary" Text="도착한 파일을 이곳에서 확인하세요" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,5,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="NotificationInboxButton" Content="최근 알림 보기" Click="ShowLatestNotification" IsEnabled="False" FontSize="11" Padding="10,6" MinHeight="30"/>
                            <Button x:Name="TestNotificationButton" Content="미리보기" Click="TestNotificationClicked" Style="{StaticResource QuietButton}" FontSize="11" Padding="10,6" MinHeight="30" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="268"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="9" Background="#EDF3FF" Margin="0,0,12,0">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="감시 폴더" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="새 파일을 기다릴 위치" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
                        </StackPanel>
                        <Border x:Name="StatusBadge" Background="#F0F2F6" CornerRadius="6" Padding="10,6" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#8A94A5" Margin="0,0,6,0"/>
                                <TextBlock x:Name="StatusText" Text="대기 중" FontSize="12" Foreground="#667085"/></StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="7" BorderThickness="1" BorderBrush="#D7DEE9" Background="#FBFCFE" Padding="12,0">
                            <Grid>
                                <TextBox x:Name="FolderInput" MinHeight="42" Padding="0" BorderThickness="0" Background="Transparent"
                                    VerticalContentAlignment="Center" FontSize="13" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="감시할 폴더 경로"/>
                                <TextBlock Text="폴더 경로 입력" FontSize="13" Foreground="#8793A5" IsHitTestVisible="False" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FolderInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Button x:Name="BrowseButton" Grid.Column="2" Content="찾아보기" Click="ChooseFolder" Padding="14,9"/>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="StartClicked" MinWidth="112">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" Foreground="White"/><TextBlock Text="감시 시작" Foreground="White"/></StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Content="중지" Click="StopClicked" IsEnabled="False" Margin="8,0,0,0" MinWidth="62"/>
                        </StackPanel>
                        <Button Content="폴더 열기 ↗" Click="OpenFolderClicked" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="8,8"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,14"/>
                    <TextBlock x:Name="StatusDetail" Text="폴더를 선택한 후 감시를 시작하세요." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="22,18">
                        <StackPanel><TextBlock Text="최근 활동" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="파일 이름과 도착 시간을 확인하세요" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="MarkReadButton" Content="알림 확인" Click="MarkReadClicked" Visibility="Collapsed" ToolTip="미확인 알림 배지 지우기" Style="{StaticResource QuietButton}" Padding="8,6" FontSize="12" MinHeight="30"/>
                            <Button x:Name="ClearHistoryButton" Content="비우기" Click="ClearClicked" Style="{StaticResource QuietButton}" Padding="8,6" FontSize="12" MinHeight="30"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource Line}"/>
                    <ListBox x:Name="ActivityList" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="10,6"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        HorizontalContentAlignment="Stretch" AutomationProperties.Name="최근 파일 및 감시 활동">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F4F7FC"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDF3FF"/></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid ToolTip="{Binding Detail}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="38" CornerRadius="7" Background="{Binding IconBackground}" HorizontalAlignment="Left">
                                    <Image Source="{Binding Artwork}" Width="30" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,20">
                        <Border Background="#F0F4FA" CornerRadius="16" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#8BA1C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="새 파일을 기다리고 있어요" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="감시를 시작하면 이곳에 기록됩니다." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="22">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="환경 설정" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="내 작업 방식에 맞게" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,26"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="하위 폴더 포함" FontSize="13" VerticalAlignment="Center"/>
                            <CheckBox x:Name="RecursiveSwitch" Grid.Column="1" Style="{StaticResource Switch}" ToolTip="하위 폴더 포함"/>
                        </Grid>
                        <TextBlock Text="안쪽 폴더의 파일도 함께 감지합니다." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,22"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="앱 실행 시 감시" FontSize="13" VerticalAlignment="Center"/>
                            <CheckBox x:Name="AutoStartSwitch" Grid.Column="1" Style="{StaticResource Switch}" ToolTip="다음 앱 실행 시 감시 시작"/>
                        </Grid>
                        <TextBlock Text="저장한 폴더에서 바로 시작합니다." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,22"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="로그인 시 자동 실행" FontSize="13" VerticalAlignment="Center"/>
                            <CheckBox x:Name="LoginStartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" ToolTip="Windows 로그인 시 자동 실행"/>
                        </Grid>
                        <TextBlock x:Name="StartupHint" Text="로그인 후 트레이에서 감시" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#F1F5FC" CornerRadius="10" Padding="16" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="작은 표시도 놓치지 않도록" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="팝업이 닫혀도 빨간 배지로&#x0a;미확인 알림을 알려드려요." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#7292BD" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="AppVersionText" Text="v1.6.0" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,14,0"/><TextBlock Text="트레이에서도 감시는 계속됩니다." Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="HideButton" Content="트레이로 숨기기" Click="HideClicked" Style="{StaticResource QuietButton}"/>
                <Button x:Name="ExitButton" Content="종료" Click="ExitClicked" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
    </ScrollViewer>
</Window>
