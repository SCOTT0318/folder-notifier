<Window x:Class="FolderNotifier.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal" Title="폴더 알림" Width="1100" Height="800" MinWidth="900" MinHeight="600"
    WindowStartupLocation="CenterScreen" Background="#F3F5F9" Foreground="{StaticResource Ink}" FontFamily="Segoe UI Variable, Malgun Gothic"
    FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Background="#F3F5F9">
        <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Padding="18,26,18,18">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1D3151" Offset="0"/><GradientStop Color="#101D33" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="BrandIcon" Width="34" Height="34" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="폴더 알림" FontSize="17" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="FILE MONITOR" FontSize="8" Foreground="#9AAECC" Margin="0,4,0,0"/></StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="SemiBold" Foreground="#8B9FBF" Margin="12,42,0,14"/>
                    <Button x:Name="MonitorNavButton" Click="NavigateMonitor" Style="{StaticResource NavButton}" Tag="selected">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" Foreground="#9CB9FF"/><TextBlock Text="모니터링" Foreground="White"/></StackPanel>
                    </Button>
                    <Button x:Name="ActivityNavButton" Click="NavigateActivity" Style="{StaticResource NavButton}" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" Foreground="#9AAECC"/><TextBlock Text="파일 기록" Foreground="#D1DDEF"/></StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavButton" Click="NavigateSettings" Style="{StaticResource NavButton}" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" Foreground="#9AAECC"/><TextBlock Text="환경 설정" Foreground="#D1DDEF"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border Background="#233752" CornerRadius="10" Padding="12" Margin="0,0,0,18">
                        <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#6AA5FF" Margin="0,0,7,0"/><TextBlock Text="{Binding Text, ElementName=StatusText}" FontSize="12" Foreground="#DFE8F5"/></StackPanel>
                            <TextBlock Text="창을 닫아도 트레이에서&#x0a;감시는 계속됩니다." Foreground="#A7B9D0" FontSize="10" LineHeight="17" Margin="0,7,0,0"/></StackPanel>
                    </Border>
                    <Button x:Name="HideButton" Content="트레이로 숨기기" Click="HideClicked" Style="{StaticResource NavButton}" FontSize="12"/>
                    <Button x:Name="ExitButton" Content="앱 종료" Click="ExitClicked" Style="{StaticResource NavButton}" FontSize="12" Margin="0,4,0,0"/>
                    <TextBlock x:Name="AppVersionText" Text="v1.8.1" Foreground="#8097B8" FontSize="10" Margin="12,18,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer x:Name="RootScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False">
        <Grid x:Name="MainSurface" Background="#F3F5F9" MinWidth="650" MinHeight="760" Width="{Binding ActualWidth, ElementName=RootScroller}" Height="{Binding ActualHeight, ElementName=RootScroller}">
        <Grid x:Name="WorkspaceLayout" Margin="24,24,24,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel><TextBlock x:Name="PageTitle" Text="내 파일 모니터" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="도착한 파일과 알림을 한곳에서 확인하세요." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
                <Border Background="#E7EDFB" CornerRadius="10" Padding="14,8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="발견한 파일" FontSize="11" Foreground="#536B9B" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FileCount" Text="0" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="12,0,4,0"/><TextBlock Text="개" FontSize="11" Foreground="#536B9B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="MonitorCard" Grid.Row="2" Style="{StaticResource Card}" Padding="22,20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="감시 폴더" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border x:Name="StatusBadge" Background="#EDF0F5" CornerRadius="8" Padding="9,4" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#8794A8" Margin="0,0,6,0"/><TextBlock x:Name="StatusText" Text="대기 중" FontSize="11" Foreground="#667085"/></StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="MonitorFolderName" Text="폴더를 연결하세요" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border CornerRadius="9" BorderThickness="1" BorderBrush="#D8E1EF" Background="#F7F9FC" Padding="12,0">
                                <Grid>
                                    <TextBox x:Name="FolderInput" MinHeight="42" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="감시할 폴더 경로"/>
                                    <TextBlock Text="폴더 경로를 입력하세요" FontSize="12" Foreground="#8A98AF" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FolderInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <Button x:Name="BrowseButton" Grid.Column="2" Content="선택" Click="ChooseFolder" Padding="14,8"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="StartButton" Content="감시 시작" Style="{StaticResource PrimaryButton}" Click="StartClicked" Padding="18,8" MinWidth="104"/>
                            <Button x:Name="StopButton" Content="중지" Click="StopClicked" IsEnabled="False" Margin="8,0,0,0" Padding="14,8"/>
                            <Button Content="폴더 열기 ↗" Click="OpenFolderClicked" Style="{StaticResource QuietButton}" Padding="10,8" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Image x:Name="FolderGraphic" Width="100" Height="96" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatusDetail" Text="폴더 선택 후 감시를 시작하세요." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" LineHeight="16"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="WorkspaceBody" Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="264"/></Grid.ColumnDefinitions>
                <Border x:Name="ActivityCard" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="20,18,20,14">
                            <Grid><TextBlock Text="파일 기록" FontSize="18" FontWeight="SemiBold"/><Button x:Name="ClearHistoryButton" Content="비우기" Click="ClearClicked" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="8,4" MinHeight="26" FontSize="11"/></Grid>
                            <Grid Margin="0,5,0,0"><TextBlock Text="최근 활동 · 최대 500개" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button x:Name="MarkReadButton" Content="알림 확인" Click="MarkReadClicked" Visibility="Collapsed" ToolTip="미확인 알림 배지 지우기" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="8,3" FontSize="11" MinHeight="24"/></Grid>
                        </StackPanel>
                        <Border Grid.Row="1" Background="{StaticResource Line}"/>
                        <ListBox x:Name="ActivityList" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="8,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" AutomationProperties.Name="최근 파일 및 감시 활동">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Row" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F4F7FC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EAF0FF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Detail}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                                <Image Source="{Binding Artwork}" Width="30" Height="36" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="12,18">
                            <Image Source="pack://application:,,,/FolderNotifier;component/Assets/folder-notifier.png" Width="48" Height="48" Opacity="0.35" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <TextBlock Text="아직 도착한 파일이 없어요" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="감시를 시작하면 여기에 기록됩니다." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid x:Name="RightPanel" Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="NotificationCard" Background="White" BorderBrush="#DFE7F2" BorderThickness="1" CornerRadius="14" Padding="16" AutomationProperties.Name="미확인 알림 카드">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Image x:Name="InboxGraphic" Width="50" Height="50" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="알림 상태 종 그래픽"/>
                            <StackPanel Grid.Column="1"><Grid><TextBlock Text="미확인 알림" FontSize="11" Foreground="{StaticResource Muted}"/><Border x:Name="UnreadCountBadge" Visibility="Collapsed" Background="#E84E5D" CornerRadius="10" Padding="6,1" HorizontalAlignment="Right"><TextBlock x:Name="UnreadCountText" Foreground="White" FontSize="10" FontWeight="Bold"/></Border></Grid>
                                <TextBlock x:Name="InboxStatus" Text="새 알림을 기다려요" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock x:Name="InboxSummary" Text="파일 도착 시 알려드릴게요" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,5,0,12"/>
                                <StackPanel Orientation="Horizontal"><Button x:Name="NotificationInboxButton" Content="최근 알림" Click="ShowLatestNotification" IsEnabled="False" FontSize="10" Padding="9,5" MinHeight="28"/><Button x:Name="TestNotificationButton" Content="미리보기" Click="TestNotificationClicked" Style="{StaticResource QuietButton}" FontSize="10" Padding="8,5" MinHeight="28" Margin="2,0,0,0"/></StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="SettingsCard" Grid.Row="2" Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock x:Name="SettingsHeading" Text="환경 설정" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock x:Name="SettingsPageHint" Text="감시 중에는 폴더와 감시 옵션이 잠깁니다. 모니터링 화면에서 중지한 뒤 변경하세요." Visibility="Collapsed" Foreground="{StaticResource Muted}" FontSize="{DynamicResource SettingsLabelSize}" TextWrapping="Wrap" Margin="0,0,0,24"/>
                            <StackPanel x:Name="NotificationDurationRow" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0"><TextBlock Text="알림 표시 시간" FontSize="{DynamicResource SettingsLabelSize}"/><TextBlock Text="자동 저장 · 마우스를 올리면 사라지지 않아요" FontSize="{DynamicResource SettingsDescriptionSize}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
                                    <ComboBox x:Name="NotificationDurationSelector" Grid.Column="1" Width="92" MinHeight="36" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="14" Padding="10,4" Background="White" BorderBrush="{StaticResource Line}" AutomationProperties.Name="알림 표시 시간" ToolTip="알림 표시 시간 (1~5초)">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0}초}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,16"/>
                            </StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="하위 폴더 포함" FontSize="{DynamicResource SettingsLabelSize}"/><TextBlock Text="안쪽 폴더까지 감지" FontSize="{DynamicResource SettingsDescriptionSize}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="RecursiveSwitch" Grid.Column="1" Style="{StaticResource Switch}" ToolTip="하위 폴더 포함"/></Grid>
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,16"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="앱 실행 시 감시" FontSize="{DynamicResource SettingsLabelSize}"/><TextBlock Text="저장한 폴더에서 시작" FontSize="{DynamicResource SettingsDescriptionSize}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="AutoStartSwitch" Grid.Column="1" Style="{StaticResource Switch}" ToolTip="다음 앱 실행 시 감시 시작"/></Grid>
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,16"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="로그인 시 실행" FontSize="{DynamicResource SettingsLabelSize}"/><TextBlock x:Name="StartupHint" Text="트레이에서 자동 감시" FontSize="{DynamicResource SettingsDescriptionSize}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><CheckBox x:Name="LoginStartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" ToolTip="Windows 로그인 시 자동 실행"/></Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
